# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openai | watsonx
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Cost tip: gpt-4o-mini is 15x cheaper and works well for K8s diagnosis
OPENAI_MODEL=gpt-4o

# ── IBM watsonx (free tier available at dataplatform.cloud.ibm.com) ───────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Recommended model — supports tool calling
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Kubernetes ────────────────────────────────────────────────────────────────
# Native Mac: use $HOME/.kube/config
# Docker:     use /root/.kube/config
KUBECONFIG_PATH=~/.kube/config
