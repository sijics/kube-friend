# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which LLM to use: "openai" or "watsonx"
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── IBM watsonx ───────────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── Kubernetes ────────────────────────────────────────────────────────────────
# Path to kubeconfig inside the container (mounted as a volume)
KUBECONFIG_PATH=/root/.kube/config
